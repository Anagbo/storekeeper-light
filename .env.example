VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only when subscription monetization officially launches.
VITE_ENABLE_SUBSCRIPTION=false
# Trial length from first app launch. Set to 0 to disable the trial.
VITE_SUBSCRIPTION_TRIAL_DAYS=30
# Paystack phone request for sales and plans. Keep false until a backend creates and confirms charges.
VITE_ENABLE_MOMO_PHONE_REQUEST=false

SUPABASE_URL=
SUPABASE_ANON_KEY=
WHATSAPP_ALLOWED_USER_IDS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_DEBT_TEMPLATE=debt_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Paystack MoMo subscription checkout (server-side only; never use a VITE_ prefix)
PAYSTACK_SECRET_KEY=
APP_URL=https://your-domain.vercel.app

# Subscription plan prices. Server values are authoritative and use pesewas.
SUBSCRIPTION_MONTHLY_AMOUNT_PESEWAS=1500
SUBSCRIPTION_SIX_MONTHS_AMOUNT_PESEWAS=7500
SUBSCRIPTION_YEARLY_AMOUNT_PESEWAS=15000

# Prices the screens show, in whole pesewas. Keep them equal to the server values above.
# (These replace the old VITE_SUBSCRIPTION_*_AMOUNT_GHS cedi variables, which are no longer read.)
VITE_SUBSCRIPTION_MONTHLY_AMOUNT_PESEWAS=1500
VITE_SUBSCRIPTION_SIX_MONTHS_AMOUNT_PESEWAS=7500
VITE_SUBSCRIPTION_YEARLY_AMOUNT_PESEWAS=15000

# Phone request fee per payment, in whole pesewas. Who pays it is not decided; it is shown as configured.
VITE_MOMO_PHONE_REQUEST_FEE_PESEWAS=0

# Ask "Is the amount right?" before saving a sale above this many pesewas (100000 = GH₵1,000.00).
# Exactly this amount saves without asking. A missing or invalid value uses 100000.
VITE_LARGE_AMOUNT_CONFIRM_PESEWAS=100000
