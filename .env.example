VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only when subscription monetization officially launches.
VITE_ENABLE_SUBSCRIPTION=false
# Trial length from first app launch. Set to 0 to disable the trial.
VITE_SUBSCRIPTION_TRIAL_DAYS=30

SUPABASE_URL=
SUPABASE_ANON_KEY=
WHATSAPP_ALLOWED_USER_IDS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_DEBT_TEMPLATE=debt_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Paystack MoMo subscription checkout (server-side only; never use a VITE_ prefix)
PAYSTACK_SECRET_KEY=
APP_URL=https://your-domain.vercel.app

# Subscription plan prices. Server values are authoritative and use pesewas.
SUBSCRIPTION_MONTHLY_AMOUNT_PESEWAS=1500
SUBSCRIPTION_SIX_MONTHS_AMOUNT_PESEWAS=7500
SUBSCRIPTION_YEARLY_AMOUNT_PESEWAS=15000

# Matching public display values for the subscription modal.
VITE_SUBSCRIPTION_MONTHLY_AMOUNT_GHS=15
VITE_SUBSCRIPTION_SIX_MONTHS_AMOUNT_GHS=75
VITE_SUBSCRIPTION_YEARLY_AMOUNT_GHS=150
